@scope {
  * {
    --duration: 100ms;
    --timing-function: ease-in-out;
  }
  /* When the Card is hovered, fade in the little Arrow icon, */
  [data-icon-arrow] {
    transition-property: opacity;
    transition-timing-function: var(--timing-function);
    transition-duration: var(--duration);
    transform-origin: center, center;
    rotate: -50deg;
    margin-left: 0.3rem;
    opacity: 0;
  }
  [data-template-card-wrapper]:hover [data-icon-arrow] {
    opacity: 1;
  }
  /* When the Card is hovered, rotate the image wrapper slightly, */
  [data-template-card-image-wrapper] {
    box-shadow: 0 5px 10px rgba(0, 0, 0, 0.12);
    transition-property: rotate;
    transition-timing-function: var(--timing-function);
    transition-duration: var(--duration);
    transform-origin: center, center;
    rotate: -6deg;
  }
  [data-template-card-wrapper]:hover [data-template-card-image-wrapper] {
    rotate: -2deg;
  }
  [data-template-card-title] {
    color: var(--title-font-color, inherit);
  }
  [data-template-card-description] {
    color: var(--description-font-color, var(--ds-gray-800));
  }
}  
