NODE endpoint
SQL >
    %
{{ max_threads(Int32(threads, 16)) }}

WITH
  owner_id as ownerId,
  project_id as projectId
SELECT
  timestamp,
  projectId,
  host as requestHostname,
  public_ip as clientIp,
  public_ip_country as clientIpCountry,
  asn_name as asnName,
  asn_id as asnId,
  ja4 as clientJa4Digest,
  if(rule = 'managed_bot_filter', 'managed_bot_protection', rule) as wafRuleId,
  action as wafAction,
  request_path as requestPath,
  target_path as route,
  dc as edgeNetworkRegion,
  user_agent as clientUserAgent,
  verified_bot as botName,
  verified_bot_category as botCategory,
  if(verified_bot != '', 'pass', '') as botVerified
FROM Vercel_Firewall.firewall_actions_v4
WHERE timestamp >= {{ DateTime(startTime, required=True) }} AND timestamp < {{ DateTime(endTime, required=True) }}
  AND wafAction in ('deny', 'challenge', 'challenge-solved', 'challenge-failed', 'log', 'redirect', 'bypass', 'rate-limit')
  -- Use the project ID, and the domain for anything not mapped. Ideally all traffic is mapped and the host query is not necessary, but this is not the case
  AND (
    (
      ${f("projectIds","ownerId")}
    ) OR (
      ownerId = '' AND projectId = '' AND requestHostname IN ${b("startTime","projectIds","ownerId")}
    )
  )${this.includeDefaultTraffic?`
UNION ALL
SELECT
  timestamp,
  project_id as projectId,
  request_hostname as requestHostname,
  client_ip as clientIp,
  client_ip_country as clientIpCountry,
  asn as asnName,
  asn_id as asnId,
  ja4_digest as clientJa4Digest,
  if(waf_rule_id = 'managed_bot_filter', 'managed_bot_protection', waf_rule_id) as wafRuleId,
  if(waf_action = '', 'allow', waf_action) as wafAction,
  request_path as requestPath,
  route,
  edge_region as edgeNetworkRegion,
  client_user_agent as clientUserAgent,
  bot_name as botName,
  bot_category as botCategory,
  if(bot_verified = 'skip', '', bot_verified) as botVerified
FROM proxy_response_raw
WHERE timestamp >= {{ DateTime(startTime, required=True) }} AND timestamp < {{ DateTime(endTime, required=True) }}
  AND ${E("projectIds","ownerId")}
  AND owner_id = {{ String(ownerId, required=True) }}
  AND path_type != 'background_func' -- match the subset of data in 'incomingRequest'
  AND waf_rule_id == '' -- Only include "default traffic" which was not blocked by the WAF
