          simpleJSONExtractString(data, 'clientRequestReferer') AS referrerUrl,
          domain(simpleJSONExtractString(data, 'clientRequestReferer')) AS referrerHostname,
          simpleJSONExtractInt(data, 'responseStatus')::Int16 AS httpStatus,
          '' AS clientIp,
          simpleJSONExtractString(data, 'clientRequestUserAgent') AS clientUserAgent,
          toLowCardinality(simpleJSONExtractString(data, 'vercelRegion')) AS edgeNetworkRegion,
          toLowCardinality(simpleJSONExtractString(data, 'computeRegion')) AS functionRegion,
          simpleJSONExtractInt(data, 'ingressBytes')::Int32 AS fotInBytes,
          simpleJSONExtractInt(data, 'egressBytes')::Int32 AS fotOutBytes,
          ceiling(simpleJSONExtractInt(data, 'cpuTimeMicroseconds')::Float32 / 50000)::Int32 AS edgeFunctionExecutionUnits,
          (simpleJSONExtractInt(data, 'cpuTimeMicroseconds') / 1000)::Float32 AS functionCpuTimeMs,
          if(
              simpleJSONHas(data, 'wallTimeMicroseconds'),
              simpleJSONExtractInt(data, 'wallTimeMicroseconds') / 1000,
              -1
          )::Float32 AS functionWallTimeMs,
          if(
              simpleJSONHas(data, 'waitUntilDurationMs'),
              simpleJSONExtractInt(data, 'waitUntilDurationMs'),
              -1
          )::Int32 AS waitUntilDurationMs,
          if(
              simpleJSONHas(data, 'newCpuTime'),
              simpleJSONExtractInt(data, 'newCpuTime'),
              -1
          )::Int32 AS cpuTimeNewMs,
          if(
              simpleJSONHas(data, 'newCpuTimeInit'),
              simpleJSONExtractInt(data, 'newCpuTimeInit'),
              -1
          )::Int32 AS cpuTimeNewInitMs,
          if(
              simpleJSONHas(data, 'throttledDuration'),
              simpleJSONExtractInt(data, 'throttledDuration'),
              -1
          )::Int32 AS cpuThrottleMs,
          if(
              simpleJSONHas(data, 'throttledDurationInit'),
              simpleJSONExtractInt(data, 'throttledDurationInit'),
