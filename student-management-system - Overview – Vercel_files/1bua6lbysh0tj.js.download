          if(
              simpleJSONHas(data, 'timeoutAfterFullResponse'),
              simpleJSONExtractBool(data, 'timeoutAfterFullResponse'),
              0
          )::UInt8 AS timeoutAfterFullResponse
      FROM Vercel_Shared.hfi_usage_facts_edge_worker_response
    WHERE timestamp >= '2025-04-16 08:00:00' AND
    (simpleJSONExtractString(data, 'invocationType') = 'edge-function' OR (simpleJSONExtractString(data, 'cause') = 'function' AND simpleJSONExtractString(data, 'runtime') = 'edge'))

