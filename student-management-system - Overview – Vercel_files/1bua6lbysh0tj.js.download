WITH
    -- Existing logic to extract path components if needed
    extractAllGroups(simpleJSONExtractString(data, 'clientRequestPath'), '^/([^/]+)/([^/]+)/([^/]+)/([^/]+)(/.*)?$') AS clientRequestPathGroups,
    -- Existing logic to calculate route
