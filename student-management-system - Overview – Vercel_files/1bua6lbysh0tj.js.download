    asn as asnName,
    asn_id as asnId,
    cache as cacheResult,
    hit_state as cacheHitState,
    hit_level as cacheHitLevel,
    edge_region as edgeNetworkRegion,
    isr_shield_region as isrShieldRegion, -- Deprecated, prefer isrCacheRegion
    isr_shield_region as isrCacheRegion,
    skew_protection as skewProtection,
    isr_shield_read_bytes as isrShieldReadBytes, -- Deprecated, prefer isrReadBytes
    isr_shield_read_bytes as isrReadBytes,
    isr_shield_write_bytes as isrShieldWriteBytes, -- Deprecated, prefer isrWriteBytes
    isr_shield_write_bytes as isrWriteBytes,
    vdc_read_units as vdcReadUnits, -- Deprecated, prefer isrReadUnits
    vdc_read_units as isrReadUnits,
    vdc_write_units as vdcWriteUnits, -- Deprecated, prefer isrWriteUnits
    vdc_write_units as isrWriteUnits
FROM ${this.tinybirdDatasource}
WHERE timestamp >= {{ DateTime(startTime, required=True) }} AND timestamp < {{ DateTime(endTime, required=True) }}
  -- Only use path_types which are relevant to ISR for performance
  AND ${e}
  AND ${E("projectIds","ownerId")}
`,i=`
${t}
NODE endpoint
SQL >
    %
{{ max_threads(Int32(threads, 16)) }}
SELECT
    timestamp,
    project_id as projectId,
    deployment_id as deploymentId,
    environment,
    path_type as pathType,
    route,
    cache as cacheResult,
    hit_state as cacheHitState,
    hit_level as cacheHitLevel,
    isr_shield_region as isrShieldRegion,
    isr_shield_region as isrCacheRegion,
    isr_shield_read_bytes as isrShieldReadBytes,
    isr_shield_read_bytes as isrReadBytes,
    isr_shield_write_bytes as isrShieldWriteBytes,
    isr_shield_write_bytes as isrWriteBytes,
    vdc_read_units as isrReadUnits,
    vdc_write_units as isrWriteUnits,
    arrayJoin(cache_tags) as cacheTags
FROM ${this.tinybirdDatasource}
WHERE timestamp >= {{ DateTime(startTime, required=True) }} AND timestamp < {{ DateTime(endTime, required=True) }}
  AND ${e}
  AND cache_tags != []
  AND ${E("projectIds","ownerId")}
`;return[{filename:`endpoints/${this.tinybirdEndpoint}.pipe`,contents:a},{filename:`endpoints/${this.tagsEndpoint}.pipe`,contents:i}]}},ea=class{constructor(e){this.tinybirdWorkspace=e.tinybirdWorkspace,this.tinybirdMaterialization=e.tinybirdMaterialization,this.tinybirdMaterializationVersion=e.tinybirdMaterializationVersion,this.tinybirdEndpoint=e.tinybirdEndpoint,this.tinybirdReadTokens=e.tinybirdReadTokens,this.event=e.event,this.retention=e.retention}canServe(e){return e.event===this.event}buildQuery(e){let t=W(e);return{tinybirdWorkspace:this.tinybirdWorkspace,tinybirdEndpoint:this.tinybirdEndpoint,sql:t,params:j(e)}}eventCountPerDayQuery(){return`
        WITH
          1 + if(toLastDayOfMonth(day) < today(), toLastDayOfMonth(day), today()) - if(toStartOfMonth(day) > toDate(min(timestamp)), toStartOfMonth(day), toDate(min(timestamp))) as daysInMonth
        SELECT '${this.event}' as event, YYYYMMDDToDate(1 + toYYYYMM(timestamp) * 100) as day, (count() / daysInMonth) :: UInt64 as eventCount
        FROM ${this.tinybirdMaterialization}
        GROUP BY ALL
        HAVING day >= toDate(min(timestamp))
        ORDER BY day ASC WITH FILL TO today() INTERPOLATE (event, eventCount)
    `}eventUsage(e){return`
        SELECT
          ownerId,
          project_id as projectId,
          toStartOfInterval(timestamp, ${e}) as timestamp,
          '${this.event}' as eventType,
          count() as count
        FROM ${this.tinybirdMaterialization}
        ANY LEFT JOIN (SELECT * FROM Vercel_Shared.projects_by_project_id__v1 FINAL) USING projectId
        WHERE {% if defined(time_bucket) %}
          timestamp = toStartOfFifteenMinutes(parseDateTimeBestEffort({{ String(time_bucket) }}))
        {% else %}
          timestamp = toStartOfFifteenMinutes(now() - ${e})
        {% end %}
        GROUP BY ALL
    `}buildSchemas(){let e=`
VERSION 1

DESCRIPTION >
    Materialization pipe for outgoing fetch requests from hfi_usage_facts_function_fetch_request.

NODE from_json
SQL >
    SELECT
        at as timestamp,
        JSONExtractString(data, 'start') as real_timestamp,
        visitParamExtractString(data, 'projectId') as project_id,
        visitParamExtractString(data, 'ownerId') as owner_id,
        visitParamExtractString(data, 'source') as source,
        visitParamExtractString(data, 'edgeType') as edge_type,
        visitParamExtractInt(data, 'duration') as duration,
        visitParamExtractInt(data, 'dnsDuration') as dns_duration,
        visitParamExtractInt(data, 'cacheDuration') as cache_duration,
        visitParamExtractInt(data, 'netDuration') as net_duration,
        visitParamExtractInt(data, 'tlsDuration') as tls_duration,
        visitParamExtractInt(data, 'statusCode') as http_status,
        visitParamExtractString(data, 'method') as request_method,
        visitParamExtractString(data, 'host') as request_hostname,
        visitParamExtractString(data, 'path') as request_path,
        visitParamExtractString(data, 'search') as request_search_params,
        visitParamExtractString(data, 'resolvedIp') as request_resolved_ip,
        visitParamExtractString(data, 'fetchType') as fetch_type,
        visitParamExtractInt(data, 'fetchIdx') as fetch_idx,
        visitParamExtractString(data, 'fetchHost') as fetch_hostname,
        visitParamExtractString(data, 'fetchPath') as fetch_path,
        visitParamExtractString(data, 'pathType') as path_type,
        visitParamExtractString(data, 'requestId') as request_id,
        visitParamExtractString(data, 'requestApi') as request_api,
        visitParamExtractString(data, 'lambdaRegion') as lambda_region,
        visitParamExtractString(data, 'deploymentId') as deployment_id,
        visitParamExtractString(data, 'invocationHost') as invocation_host,
        visitParamExtractString(data, 'invocationPath') as invocation_path,
        visitParamExtractString(data, 'invocationRoute') as invocation_route,
        visitParamExtractInt(data, 'unresolved') as unresolved,
        visitParamExtractString(data, 'reason') as reason,
        visitParamExtractString(data, 'environment') as environment,
        visitParamExtractInt(data, 'bodyDuration') as body_duration,
        visitParamExtractInt(data, 'requestTransferBytes') as request_transfer_bytes,
        visitParamExtractInt(data, 'responseTransferBytes') as response_transfer_bytes
    FROM Vercel_Shared.hfi_usage_facts_function_fetch_request
    WHERE request_hostname != 'localhost' AND request_path != '/v1/traces'

NODE mv_fetch_requests
SQL >
    WITH
        length(real_timestamp) > 10 as has_real_timestamp,
        multiIf(
            from_json.fetch_type = 'fetch-get',
            'cache-get',
            from_json.fetch_type = 'fetch-set',
            'cache-set',
            empty(from_json.fetch_type),
            'origin',
            from_json.fetch_type
        ) as normalised_fetch_type,
        if(
            normalised_fetch_type != 'origin' and notEmpty(from_json.fetch_hostname),
            from_json.fetch_path,
            from_json.request_path
        ) as real_request_path
    select
        coalesce(
            if(has_real_timestamp, parseDateTime64BestEffortOrNull(real_timestamp), null),
            toDateTime64(timestamp - interval duration ms, 3)
        ) as timestamp,
        project_id,
        owner_id,
        toLowCardinality(source) as source,
        toLowCardinality(edge_type) as edge_type,
        toUInt16(duration) duration_ms,
        toUInt16(dns_duration) dns_duration_ms,
        toUInt16(cache_duration) cache_duration_ms,
        toUInt16(net_duration) net_duration_ms,
        toUInt16(tls_duration) tls_duration_ms,
        toInt16(http_status) as http_status,
        toLowCardinality(upper(request_method)) as request_method,
        if(
            normalised_fetch_type != 'origin' and notEmpty(from_json.fetch_hostname),
            from_json.fetch_hostname,
            from_json.request_hostname
        ) as request_hostname,
        multiIf(
            request_hostname = 'api.telegram.org',
            replaceRegexpOne(real_request_path, '^(/bot)([0-9a-zA-Z]+:[0-9a-zA-Z_-]+)(/)', '\\\\1***\\\\3'),
            request_hostname = 'discord.com' and startsWith(real_request_path, '/api/webhooks/'),
            replaceRegexpOne(
                real_request_path,
                '\\/api\\/webhooks\\/([^\\/]+)\\/[^\\/]+(\\/?\\/[^\\/]*)?',
                '/api/webhooks/\\\\1/***\\\\2'
            ),
            real_request_path
        ) request_path,
        if(
            normalised_fetch_type != 'origin' and notEmpty(fetch_hostname),
            from_json.request_hostname,
            ''
        ) cache_hostname,
        extractKeyValuePairs(left(request_search_params, 256), '=', '&') as request_search_params,
        request_resolved_ip,
        if(
            normalised_fetch_type != 'origin' and notEmpty(fetch_hostname), from_json.request_path, ''
        ) cache_path,
        invocation_host as origin_hostname,
        invocation_path as origin_path,
        replaceRegexpAll(
            replaceRegexpAll(invocation_route, '/_next/data/[^/]+', '/_next/data/[buildId]'),
            '(\\.rsc|\\.prefetch)$',
            ''
        ) as origin_route,
        toLowCardinality(normalised_fetch_type) as fetch_type,
        toUInt16(fetch_idx) as fetch_idx,
        path_type,
        request_id,
        toLowCardinality(request_api) as request_api,
        toLowCardinality(lambda_region) as function_region,
        deployment_id,
        toUInt8(unresolved) as unresolved,
        reason,
        toLowCardinality(environment) as environment,
        if(body_duration > 0, toInt32(body_duration), -1) as body_duration_ms,
        if(request_transfer_bytes >= 0, toInt32(request_transfer_bytes), -1) as request_transfer_bytes,
        if(response_transfer_bytes >= 0, toInt32(response_transfer_bytes), -1) as response_transfer_bytes
    from from_json

TYPE materialized
DATASOURCE ${this.tinybirdMaterialization}
`,t=`
VERSION ${this.tinybirdMaterializationVersion}

${this.tinybirdReadTokens.map(e=>`TOKEN ${e} READ`).join("\n")}

SCHEMA >
    timestamp DateTime64(3),
    date Date DEFAULT toDate(timestamp),
    project_id String,
    owner_id String DEFAULT '',
    environment LowCardinality(String),
    source LowCardinality(String),
    edge_type LowCardinality(String),
    duration_ms UInt16,
    dns_duration_ms UInt16,
    cache_duration_ms UInt16,
    net_duration_ms UInt16,
    tls_duration_ms UInt16,
    http_status Int16,
    request_method LowCardinality(String),
    request_hostname String,
    request_path String,
    request_resolved_ip String,
    request_search_params Map(String, String) DEFAULT map(),
    cache_hostname String,
    cache_path String,
    origin_hostname String,
    origin_path String,
    origin_route String,
    fetch_type LowCardinality(String),
    fetch_idx UInt16,
    path_type String,
    request_id String,
