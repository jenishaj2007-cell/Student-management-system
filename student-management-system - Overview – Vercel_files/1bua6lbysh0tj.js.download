      SELECT DISTINCT domain as requestHostname, parentProjectId as projectId FROM Vercel_Shared.domain_by_parent_project_id_v1
      WHERE requestedAt >= {{ DateTime(startTime, required=True) }}
       AND ownerId = {{ String(${e}, required=True) }}
       AND ${E("projectIds",e)}
      LIMIT 1 BY requestHostname
    )`)} USING requestHostname
WHERE timestamp >= {{ DateTime(startTime, required=True) }} AND timestamp < {{ DateTime(endTime, required=True) }}
  AND wafAction in ('deny', 'challenge', 'challenge-solved', 'challenge-failed', 'log', 'redirect', 'bypass', 'rate-limit')
  -- We need this filter (in addition to the join)
  AND requestHostname IN ${b("startTime","projectIds","ownerId")}${this.includeDefaultTraffic?`
UNION ALL
SELECT
  timestamp,
  project_id as projectId,
  request_hostname as requestHostname,
  client_ip as clientIp,
  client_ip_country as clientIpCountry,
  asn as asnName,
  asn_id as asnId,
  ja4_digest as clientJa4Digest,
  if(waf_rule_id = 'managed_bot_filter', 'managed_bot_protection', waf_rule_id) as wafRuleId,
  if(waf_action = '', 'allow', waf_action) as wafAction,
  request_path as requestPath,
  route,
  edge_region as edgeNetworkRegion,
  client_user_agent as clientUserAgent,
  initializeAggregation('countState', 1) as total
FROM proxy_response_raw
WHERE timestamp >= {{ DateTime(startTime, required=True) }} AND timestamp < {{ DateTime(endTime, required=True) }}
  AND ${E("projectIds","ownerId")}
  AND owner_id = {{ String(ownerId, required=True) }}
  AND path_type != 'background_func' -- match the subset of data in 'incomingRequest'
  AND waf_rule_id == '' -- Only include "default traffic" which was not blocked by the WAF
