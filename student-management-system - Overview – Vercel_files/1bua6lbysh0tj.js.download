SELECT
    -- Core Identifiers & Context
    at AS timestamp,
    simpleJSONExtractString(data, 'projectId') AS projectId,
    simpleJSONExtractString(data, 'ownerId') AS ownerId,
    simpleJSONExtractString(data, 'deploymentId') AS deploymentId,
    toLowCardinality(simpleJSONExtractString(data, 'deploymentPlan')) AS deploymentPlan,
    splitByString('::', simpleJSONExtractString(data, 'vercelId'))[-1] AS requestId, -- Use vercelId
    toLowCardinality(simpleJSONExtractString(data, 'environment')) AS environment,

    -- Middleware Specifics
    toLowCardinality(simpleJSONExtractString(data, 'middlewareAction')) AS middlewareAction,
    simpleJSONExtractString(data, 'middlewareActionTarget') AS middlewareActionTarget,

    -- Request Details
    if(
        simpleJSONHas(data, 'clientRequestHost'),
        simpleJSONExtractString(data, 'clientRequestHost'),
        if(
            length(clientRequestPathGroups) > 0,
            clientRequestPathGroups[1][4],
            ''
        )
    ) AS requestHost,
    if(
        length(clientRequestPathGroups) > 0,
        coalesce(clientRequestPathGroups[1][5], simpleJSONExtractString(data, 'clientRequestPath')),
        simpleJSONExtractString(data, 'clientRequestPath')
    ) AS requestPath,
    toLowCardinality(
        if(
            simpleJSONHas(data, 'clientRequestMethod'),
            simpleJSONExtractString(data, 'clientRequestMethod'),
            if(
                length(clientRequestPathGroups) > 0,
                clientRequestPathGroups[1][2],
                'GET' -- Default to GET if no method found
            )
        )
    ) AS requestMethod,
    route,
    simpleJSONExtractString(data, 'clientRequestReferer') AS referer,
    domain(referer) AS referrerHostname,
    if(simpleJSONHas(data, 'responseStatus'), simpleJSONExtractInt(data, 'responseStatus'), 200)::Int16 AS statusCode,

    -- Client Details
    '' AS publicIp,
    simpleJSONExtractString(data, 'clientRequestUserAgent') AS userAgent,

    -- Execution Location & Type
    if(simpleJSONHas(data, 'functionName'), 'lambda', 'cf') as provider,
    if(simpleJSONExtractString(data, 'invocationType') = 'middleware', 'middleware', 'function') as cause,
    'edge' AS runtime,
    toLowCardinality(simpleJSONExtractString(data, 'vercelRegion')) AS vercelRegion,
    toLowCardinality(simpleJSONExtractString(data, 'computeRegion')) AS lambdaRegion,
    toLowCardinality(simpleJSONExtractString(data, 'startType')) AS startType,

    -- Performance & Resource Measures
    if(simpleJSONHas(data, 'ingressBytes'), simpleJSONExtractInt(data, 'ingressBytes'), 0)::Int64 AS ingressBytes,
    if(simpleJSONHas(data, 'egressBytes'), simpleJSONExtractInt(data, 'egressBytes'), 0)::Int64 AS egressBytes,
    if(simpleJSONHas(data, 'wallTimeMicroseconds'), simpleJSONExtractFloat(data, 'wallTimeMicroseconds') / 1000.0, 0.0)::Int32 AS requestDurationMs,
    if(simpleJSONHas(data, 'timeToFirstByteMs'), simpleJSONExtractInt(data, 'timeToFirstByteMs'), 0)::Int64 AS timeToFirstByte,
    if(simpleJSONHas(data, 'cpuTimeMicroseconds'), simpleJSONExtractInt(data, 'cpuTimeMicroseconds') / 1000, -1)::Int64 AS cpuTime,
    if(simpleJSONHas(data, 'newCpuTime'), simpleJSONExtractInt(data, 'newCpuTime'), -1)::Int64 AS newCpuTime,

    -1::Int64 AS cpuTimeInit,
    -1::Int64 AS throttledDuration,
    -1::Int32 AS lambdaMemorySize,
    -1::Int32 AS maxMemoryUsed,
    -1::Int32 AS billedDurationMs,
    -1::Int32 AS waitUntilDurationMs,

    -- Internal/Debugging Fields
    toLowCardinality('') AS errorCategory,
    toLowCardinality('') AS framework,
    '' AS frameworkVersion,
    simpleJSONExtractString(data, 'functionName') AS lambdaName,
    if(simpleJSONHas(data, 'n1mc'), simpleJSONExtractBool(data, 'n1mc'), 0)::UInt8 AS n1mc,
    if(simpleJSONHas(data, 'timeToHandler'), simpleJSONExtractInt(data, 'timeToHandler'), -1)::Int32 AS timeToHandler,
    -1::Int32 AS rustyTimeToHandler,
    if(simpleJSONHas(data, 'isAdditionalRequest'), simpleJSONExtractBool(data, 'isAdditionalRequest'), 0)::UInt8 AS isAdditionalRequest,
    if(simpleJSONHas(data, 'concurrency'), simpleJSONExtractUInt(data, 'concurrency'), 1)::UInt8 AS concurrency,
    if(simpleJSONHas(data, 'maxConcurrency'), simpleJSONExtractUInt(data, 'maxConcurrency'), 1)::UInt8 AS maxConcurrency,
    toLowCardinality(simpleJSONExtractString(data, 'bridgeVersion')) AS bridgeVersion,
    if(simpleJSONHas(data, 'totalRequests'), simpleJSONExtractUInt(data, 'totalRequests'), 1)::UInt16 AS totalRequests,
    simpleJSONExtractString(data, 'invocationId') AS invocationId,
    simpleJSONExtractString(data, 'instanceId') AS instanceId,
    if(
      visitParamHas(data, 'coldStartDurationMs'), toInt32(visitParamExtractInt(data, 'coldStartDurationMs')), -1
    ) AS coldStartDurationMs,
    simpleJSONExtractString(data, 'lambdaRequestId') AS lambdaRequestId

