  WHERE pathType = 'blob' and timestamp > '2025-06-05 13:20:00'
  `,tinybirdDatasource:"blob_data_transfer_raw",tinybirdDatasourcePartitionKey:"toYYYYMM(timestamp)",tinybirdDatasourceSortingKey:"storeId, toStartOfHour(timestamp), requestPath",tinybirdEndpoint:"ep_blob_data_transfer_raw",tinybirdReadTokens:es,event:"blobDataTransfer",determineScopeBy:"store",dimensions:[{queryable:!1,column:"ownerId",storageType:"String"},{queryable:!1,column:"projectId",storageType:"String"},{name:"storeId",storageType:"String"},{name:"storeName",joinOnColumn:"storeId",table:e=>(0,y.storeIdToNameTable)(e)},{name:"requestMethod",storageType:"LowCardinality(String)"},{name:"requestPath",storageType:"String"},{name:"requestId",storageType:"String"},{name:"referrerUrl",storageType:"String"},{name:"referrerHostname",storageType:"String"},{name:"httpStatus",storageType:"Int16"},{name:"edgeNetworkRegion",storageType:"LowCardinality(String)"},{name:"cacheResult",storageType:"LowCardinality(String)"},{name:"cacheHitState",storageType:"LowCardinality(String)"},{name:"cacheHitLevel",storageType:"LowCardinality(String)"},{name:"clientIp",storageType:"String"},{name:"clientIpCountry",storageType:"String"},{name:"clientUserAgent",storageType:"String"},{name:"pathType",storageType:"LowCardinality(String)"}],measures:[{name:"bdtOutBytes",storageType:"Int32"}],retention:{days:92}});var e6=new eu({tinybirdWorkspace:en,tinybirdPipe:"pipe_ufp_ai_gateway_request_v3",tinybirdPipeQuery:`
  SELECT
      at as timestamp,
      simpleJSONExtractString(data, 'projectId') as projectId,
      simpleJSONExtractString(data, 'ownerId') as ownerId,
      simpleJSONExtractString(data, 'gatewayApiKeyId') as keyId,
      simpleJSONExtractString(data, 'authMethod') :: LowCardinality(String) as authMethod,
      -- Dimensions
      simpleJSONExtractString(data, 'referringSiteUrl') as referrerUrl,
      simpleJSONExtractString(data, 'referringSiteName') as appName,
      simpleJSONExtractString(data, 'environment') as environment,
      simpleJSONExtractString(data, 'deploymentId') as deploymentId,
      simpleJSONExtractString(data, 'gatewayModelId') :: LowCardinality(String) as gatewayModelId,
      simpleJSONExtractString(data, 'model') :: LowCardinality(String) as model,
      simpleJSONExtractString(data, 'modelType') :: LowCardinality(String) as modelType,
      simpleJSONExtractString(data, 'servedSpeed') :: LowCardinality(String) as servedSpeed,
      simpleJSONExtractString(data, 'provider') :: LowCardinality(String) as provider,
      simpleJSONExtractString(data, 'currency') :: LowCardinality(String) as currency,
      simpleJSONExtractString(data, 'marketCostCurrency') :: LowCardinality(String) as marketCostCurrency,
      simpleJSONExtractString(data, 'inputCostPerTokenCurrency') :: LowCardinality(String) as inputCostPerTokenCurrency,
      simpleJSONExtractString(data, 'outputCostPerTokenCurrency') :: LowCardinality(String) as outputCostPerTokenCurrency,
      simpleJSONExtractString(data, 'cachedInputTokensCostCurrency') :: LowCardinality(String) as cachedInputTokensCurrency,
      simpleJSONExtractString(data, 'cacheCreationInputTokensCostCurrency') :: LowCardinality(String) as cacheCreationInputTokensCurrency,
      simpleJSONExtractString(data, 'cacheCreation1hInputTokensCostCurrency') :: LowCardinality(String) as cacheCreation1hInputTokensCurrency,
      simpleJSONExtractString(data, 'surchargeCostCurrency') :: LowCardinality(String) as surchargeCostCurrency,
      simpleJSONExtractString(data, 'gatewayCostCurrency') :: LowCardinality(String) as gatewayCostCurrency,
      if(simpleJSONHas(data, 'addedCreditCard'), if(simpleJSONExtractBool(data, 'addedCreditCard'), 'card-present', 'no-card-present'), 'unknown') :: LowCardinality(String) as addedCreditCard,
      if(simpleJSONHas(data, 'isFreeTier'), if(simpleJSONExtractBool(data, 'isFreeTier'), 'free-tier', 'paid-tier'), 'unknown') :: LowCardinality(String) as isFreeTier,
      if(simpleJSONHas(data, 'isByok'), if(simpleJSONExtractBool(data, 'isByok'), 'byok', 'not-byok'), 'unknown') :: LowCardinality(String) as isByok,
      if(simpleJSONHas(data, 'isPrivateModel'), if(simpleJSONExtractBool(data, 'isPrivateModel'), 'private-model', 'not-private-model'), 'unknown') :: LowCardinality(String) as isPrivateModel,
      if(simpleJSONHas(data, 'isStreaming'), if(simpleJSONExtractBool(data, 'isStreaming'), 'streamed', 'generated'), 'unknown') :: LowCardinality(String) as isStreaming,
      if(simpleJSONHas(data, 'isRequestZdr'), if(simpleJSONExtractBool(data, 'isRequestZdr'), 'zdr-requested', 'no-zdr-requested'), 'unknown') :: LowCardinality(String) as isRequestZdr,
      if(simpleJSONHas(data, 'hipaaRequested'), if(simpleJSONExtractBool(data, 'hipaaRequested'), 'hipaa-requested', 'no-hipaa-requested'), 'unknown') :: LowCardinality(String) as hipaaRequested,
      if(simpleJSONHas(data, 'quotaRequested'), if(simpleJSONExtractBool(data, 'quotaRequested'), 'quota-requested', 'no-quota-requested'), 'unknown') :: LowCardinality(String) as quotaRequested,
      simpleJSONExtractString(data, 'quotaEntityId') as quotaEntityId,
      simpleJSONExtractString(data, 'quotaEntityType') :: LowCardinality(String) as quotaEntityType,
      simpleJSONExtractString(data, 'generationId') as generationId,
      simpleJSONExtractString(data, 'finishReason') as finishReason,
      simpleJSONExtractString(data, 'userId') as userId,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(simpleJSONExtractString(data, 'tags'))) as tags,
      simpleJSONExtractString(data, 'userAgent') as userAgent,
      simpleJSONExtractString(data, 'requestApiFormat') :: LowCardinality(String) as requestApiFormat,
      simpleJSONExtractString(data, 'vmcModelId') as vmcModelId,
      simpleJSONExtractString(data, 'vmcKind') :: LowCardinality(String) as vmcKind,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(simpleJSONExtractString(data, 'vmcByokCredentialIds'))) as vmcByokCredentialIds,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(simpleJSONExtractString(data, 'vmcProviderOrder'))) as vmcProviderOrder,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(simpleJSONExtractString(data, 'vmcProviderOnly'))) as vmcProviderOnly,
      JSONExtract(simpleJSONExtractString(data, 'vmcInferenceRegion'), 'Map(String, String)') as vmcInferenceRegion,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(simpleJSONExtractString(data, 'requestProviderOnly'))) as requestProviderOnly,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(simpleJSONExtractString(data, 'requestProviderOrder'))) as requestProviderOrder,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(simpleJSONExtractString(data, 'requiredCapabilities'))) as requiredCapabilities,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(simpleJSONExtractString(data, 'appliedPremiums'))) as appliedPremiums,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(simpleJSONExtractString(data, 'appliedRuleIds'))) as appliedRuleIds,
      simpleJSONExtractString(data, 'sortOption') :: LowCardinality(String) as sortOption,
      simpleJSONExtractString(data, 'byokCredentialId') as byokCredentialId,
      simpleJSONExtractString(data, 'region') :: LowCardinality(String) as region,
      simpleJSONExtractString(data, 'teamSlug') as teamSlug,
      simpleJSONExtractString(data, 'teamName') as teamName,
      simpleJSONExtractString(data, 'teamPlanType') :: LowCardinality(String) as teamPlanType,
      simpleJSONExtractString(data, 'billingStatus') :: LowCardinality(String) as billingStatus,
      simpleJSONExtractString(data, 'serviceTier') :: LowCardinality(String) as serviceTier,
      simpleJSONExtractString(data, 'vercelId') as requestId,
      simpleJSONExtractString(data, 'sessionId') as sessionId,
      simpleJSONExtractString(data, 'ipAddress') as ipAddress,
      simpleJSONExtractString(data, 'contentCaptureStatus') as contentCaptureStatus,
      if(simpleJSONHas(data, 'contentCaptureInputs'), simpleJSONExtractString(data, 'contentCaptureInputs'), '[]') as contentCaptureInputs,
      if(simpleJSONHas(data, 'contentCaptureOutputs'), simpleJSONExtractString(data, 'contentCaptureOutputs'), '[]') as contentCaptureOutputs,
      simpleJSONExtractString(data, 'inferenceEndpointSlug') :: LowCardinality(String) as inferenceEndpointSlug,
      simpleJSONExtractString(data, 'inferenceScope') :: LowCardinality(String) as inferenceScope,
      simpleJSONExtractString(data, 'inferenceGeoRegion') :: LowCardinality(String) as inferenceGeoRegion,
      simpleJSONExtractString(data, 'inferenceProviderRegion') :: LowCardinality(String) as inferenceProviderRegion,
      simpleJSONExtractString(data, 'requestedInferenceRegion') as requestedInferenceRegion,
      -- Measures
      if(simpleJSONHas(data, 'cost'), simpleJSONExtractString(data, 'cost'), simpleJSONExtractString(data, 'amount')) :: Decimal(38, 10) as cost,
      if(simpleJSONHas(data, 'marketCost'), simpleJSONExtractString(data, 'marketCost'), simpleJSONExtractString(data, 'amount')) :: Decimal(38, 10) as marketCost,
      if(simpleJSONHas(data, 'inputCostPerToken') AND simpleJSONExtractString(data, 'inputCostPerToken') != '', simpleJSONExtractString(data, 'inputCostPerToken'), '0') :: Decimal(38, 10) as inputCostPerToken,
      if(simpleJSONHas(data, 'inputListCostPerToken') AND simpleJSONExtractString(data, 'inputListCostPerToken') != '', simpleJSONExtractString(data, 'inputListCostPerToken'), '0') :: Decimal(38, 10) as inputListCostPerToken,
      simpleJSONExtractInt(data, 'inputTokens') :: Int64 as inputTokens,
      if(simpleJSONHas(data, 'outputCostPerToken') AND simpleJSONExtractString(data, 'outputCostPerToken') != '', simpleJSONExtractString(data, 'outputCostPerToken'), '0') :: Decimal(38, 10) as outputCostPerToken,
      if(simpleJSONHas(data, 'outputListCostPerToken') AND simpleJSONExtractString(data, 'outputListCostPerToken') != '', simpleJSONExtractString(data, 'outputListCostPerToken'), '0') :: Decimal(38, 10) as outputListCostPerToken,
      simpleJSONExtractInt(data, 'outputTokens') :: Int64 as outputTokens,
      simpleJSONExtractInt(data, 'cachedInputTokens') :: Int64 as cachedInputTokens,
      if(simpleJSONHas(data, 'cachedInputListTokensCost') AND simpleJSONExtractString(data, 'cachedInputListTokensCost') != '', simpleJSONExtractString(data, 'cachedInputListTokensCost'), '0') :: Decimal(38, 10) as cachedInputListTokensCost,
      simpleJSONExtractInt(data, 'cacheCreationInputTokens') :: Int64 as cacheCreationInputTokens,
      if(simpleJSONHas(data, 'cacheCreationInputListTokensCost') AND simpleJSONExtractString(data, 'cacheCreationInputListTokensCost') != '', simpleJSONExtractString(data, 'cacheCreationInputListTokensCost'), '0') :: Decimal(38, 10) as cacheCreationInputListTokensCost,
      if(simpleJSONHas(data, 'cacheCreation1hInputTokens'), simpleJSONExtractInt(data, 'cacheCreation1hInputTokens'), 0) :: Int64 as cacheCreation1hInputTokens,
      if(simpleJSONHas(data, 'cacheCreation1hInputTokensCost') AND simpleJSONExtractString(data, 'cacheCreation1hInputTokensCost') != '', simpleJSONExtractString(data, 'cacheCreation1hInputTokensCost'), '0') :: Decimal(38, 10) as cacheCreation1hInputTokensCost,
      simpleJSONExtractInt(data, 'reasoningTokens') :: Int64 as reasoningTokens,
      if(simpleJSONHas(data, 'webSearchCallCount'), simpleJSONExtractInt(data, 'webSearchCallCount'), -1) :: Int64 as webSearchCallCount,
      if(simpleJSONHas(data, 'googleMapsSearchCallCount'), simpleJSONExtractInt(data, 'googleMapsSearchCallCount'), -1) :: Int64 as googleMapsSearchCallCount,
      if(simpleJSONHas(data, 'gatewayToolCallCount'), simpleJSONExtractInt(data, 'gatewayToolCallCount'), -1) :: Int64 as gatewayToolCallCount,
      if(simpleJSONHas(data, 'gatewayToolCallCost'), simpleJSONExtractString(data, 'gatewayToolCallCost'), '0') :: Decimal(38, 10) as gatewayToolCallCost,
      fromUnixTimestamp64Milli(simpleJSONExtractInt(data, 'gatewayTimestamp')) as gatewayTimestamp,
      simpleJSONExtractInt(data, 'requestDurationMs') :: Int64 as requestDurationMs,
      if(simpleJSONHas(data, 'gatewayOverheadMs'), simpleJSONExtractInt(data, 'gatewayOverheadMs'), -1) :: Int64 as gatewayOverheadMs,
      simpleJSONExtractInt(data, 'timeToFirstTokenMs') :: Int64 as timeToFirstTokenMs,
      if(simpleJSONHas(data, 'timeToFirstReasoningTokenMs'), simpleJSONExtractInt(data, 'timeToFirstReasoningTokenMs'), -1) :: Int64 as timeToFirstReasoningTokenMs,
      if(simpleJSONHas(data, 'timeToFirstTextTokenMs'), simpleJSONExtractInt(data, 'timeToFirstTextTokenMs'), -1) :: Int64 as timeToFirstTextTokenMs,
      simpleJSONExtractInt(data, 'tokenThroughput') :: Float64 as tokenThroughput,
      simpleJSONExtractInt(data, 'responseStatusCode') :: Int16 as responseStatusCode,
      if(simpleJSONHas(data, 'internalResponseStatusCode'), simpleJSONExtractInt(data, 'internalResponseStatusCode'), -1) :: Int16 as internalResponseStatusCode,
      if(simpleJSONHas(data, 'rerankingQueryCount'), simpleJSONExtractInt(data, 'rerankingQueryCount'), -1) :: Int64 as rerankingQueryCount,
      if(simpleJSONHas(data, 'imageCount'), simpleJSONExtractInt(data, 'imageCount'), 0) :: Int64 as imageCount,
      if(simpleJSONHas(data, 'videoCount'), simpleJSONExtractInt(data, 'videoCount'), 0) :: Int64 as videoCount,
      if(simpleJSONHas(data, 'videoDurationSeconds'), simpleJSONExtractFloat(data, 'videoDurationSeconds'), 0) :: Float64 as videoDurationSeconds,
      (if(simpleJSONHas(data, 'transcriptionInputDurationSeconds'), simpleJSONExtractFloat(data, 'transcriptionInputDurationSeconds'), 0) + if(simpleJSONHas(data, 'realtimeSessionDurationSeconds'), simpleJSONExtractFloat(data, 'realtimeSessionDurationSeconds'), 0)) :: Float64 as audioDurationSeconds,
      simpleJSONExtractString(data, 'videoResolution') :: LowCardinality(String) as videoResolution,
      simpleJSONExtractString(data, 'videoAspectRatio') :: LowCardinality(String) as videoAspectRatio,
      if(simpleJSONHas(data, 'videoFps'), simpleJSONExtractInt(data, 'videoFps'), 0) :: Int64 as videoFps,
      if(simpleJSONHas(data, 'realtimeSessionDurationSeconds'), simpleJSONExtractFloat(data, 'realtimeSessionDurationSeconds'), 0) :: Float64 as realtimeSessionDurationSeconds,
      if(simpleJSONHas(data, 'realtimeClientMessageCount'), simpleJSONExtractInt(data, 'realtimeClientMessageCount'), 0) :: Int64 as realtimeClientMessageCount,
      if(simpleJSONHas(data, 'zdrCost'), simpleJSONExtractString(data, 'zdrCost'), '0') :: Decimal(38, 10) as zdrCost,
      if(simpleJSONHas(data, 'reportingWriteCost'), simpleJSONExtractString(data, 'reportingWriteCost'), '0') :: Decimal(38, 10) as reportingWriteCost,
      if(simpleJSONHas(data, 'providerAllowlistCost'), simpleJSONExtractString(data, 'providerAllowlistCost'), '0') :: Decimal(38, 10) as providerAllowlistCost,
      if(simpleJSONHas(data, 'modelAllowlistCost'), simpleJSONExtractString(data, 'modelAllowlistCost'), '0') :: Decimal(38, 10) as modelAllowlistCost,
      if(simpleJSONHas(data, 'quotaWriteCost'), simpleJSONExtractString(data, 'quotaWriteCost'), '0') :: Decimal(38, 10) as quotaWriteCost,
      if(simpleJSONHas(data, 'surchargeCost'), simpleJSONExtractString(data, 'surchargeCost'), '0') :: Decimal(38, 10) as surchargeCost,
      if(simpleJSONHas(data, 'gatewayCost'), simpleJSONExtractString(data, 'gatewayCost'), '0') :: Decimal(38, 10) as gatewayCost,
      if(simpleJSONHas(data, 'piiRedactionApplied'), if(simpleJSONExtractBool(data, 'piiRedactionApplied'), 'applied', 'not-applied'), 'unknown') :: LowCardinality(String) as piiRedactionApplied,
      if(simpleJSONHas(data, 'piiRedactedEntityCount'), simpleJSONExtractInt(data, 'piiRedactedEntityCount'), -1) :: Int64 as piiRedactedEntityCount,
      if(simpleJSONHas(data, 'moderationApplied'), if(simpleJSONExtractBool(data, 'moderationApplied'), 'applied', 'not-applied'), 'unknown') :: LowCardinality(String) as moderationApplied,
      simpleJSONExtractString(data, 'moderationPolicy') as moderationPolicy,
      simpleJSONExtractString(data, 'moderationResult') :: LowCardinality(String) as moderationResult,
      if(simpleJSONHas(data, 'piiRedactionLatencyMs'), simpleJSONExtractInt(data, 'piiRedactionLatencyMs'), -1) :: Int64 as piiRedactionLatencyMs,
      if(simpleJSONHas(data, 'moderationLatencyMs'), simpleJSONExtractInt(data, 'moderationLatencyMs'), -1) :: Int64 as moderationLatencyMs
  FROM Vercel_Shared.hfi_usage_facts_ai_gateway
  WHERE name = 'AI_GATEWAY_REQUEST'`,tinybirdDatasource:"ai_gateway_request_raw_v2",tinybirdDatasourcePartitionKey:"toYYYYMM(timestamp)",tinybirdDatasourceSortingKey:"projectId, keyId, toStartOfHour(timestamp), environment",tinybirdEndpoint:"ep_ai_gateway_request_raw_v2",tinybirdReadTokens:es,sharedWith:["Vercel_AI","Vercel_Datadog","Vercel_S3_Export"],event:"aiGatewayRequest",determineScopeBy:"projectOrKey",eventUsageQuery:(e,t)=>`
      SELECT
        ownerId,
        projectId,
        toStartOfInterval(timestamp, ${t}) as timestamp,
        '${e.event}' as eventType,
        count() as count
      FROM ${e.tinybirdDatasource}
      ANY LEFT JOIN (SELECT * FROM Vercel_Shared.projects_by_project_id__v1 FINAL) USING projectId
      WHERE {% if defined(time_bucket) %}
        timestamp = toStartOfFifteenMinutes(parseDateTimeBestEffort({{ String(time_bucket) }}))
      {% else %}
        timestamp = toStartOfFifteenMinutes(now() - ${t})
      {% end %}
      GROUP BY ALL
