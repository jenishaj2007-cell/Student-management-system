          simpleJSONExtractString(data, 'deploymentId') AS deploymentId,
          toLowCardinality(simpleJSONExtractString(data, 'deploymentPlan')) AS deploymentPlan,
          toLowCardinality(simpleJSONExtractString(data, 'bridgeVersion')) AS bridgeVersion,
          toLowCardinality(simpleJSONExtractInt(data, 'memorySizeMb'))::Int32 AS provisionedMemoryMb,
          simpleJSONExtractInt(data, 'maxMemoryUsed')::Int32 AS maxMemoryUsed,
          simpleJSONExtractString(data, 'invocationId') AS invocationId,
          simpleJSONExtractString(data, 'instanceId') AS instanceId,
          toLowCardinality(simpleJSONExtractString(data, 'startType')) AS functionStartType,
          toLowCardinality(simpleJSONExtractString(data, 'errorCategory')) AS errorCode,
          if(simpleJSONHas(data, 'functionName'), 'lambda', 'cf') as provider,
          splitByString('::', visitParamExtractString(data, 'vercelId'))[-1] AS requestId,
