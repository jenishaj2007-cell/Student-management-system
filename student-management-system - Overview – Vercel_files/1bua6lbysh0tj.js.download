NODE endpoint
SQL >
    %
{{ max_threads(Int32(threads, 2)) }}

SELECT
  timestamp,
  projectId,
  host as requestHostname,
  public_ip as clientIp,
  finalizeAggregation(public_ip_country) as clientIpCountry,
  finalizeAggregation(asn_name) as asnName,
  finalizeAggregation(asn_id) as asnId,
  ja4 as clientJa4Digest,
  if(rule = 'managed_bot_filter', 'managed_bot_protection', rule) as wafRuleId,
  action as wafAction,
  request_path as requestPath,
  target_path as route,
  dc as edgeNetworkRegion,
  user_agent as clientUserAgent,
  cnt as total
FROM Vercel_Firewall.internal_firewall_actions
