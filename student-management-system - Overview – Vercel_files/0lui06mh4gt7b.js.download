.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Zomato",discoveryServerUrl:"https://mcp-server.zomato.com/mcp",label:"MCP"}]},{type:"anthropic",service:"anthropic",label:"Anthropic",description:"Anthropic Claude models and the Messages API",icon:"/static/connex/anthropic.svg",enabled:!0,methods:[{kind:"api-key",name:"Anthropic",service:"api.anthropic.com",docUrl:"https://console.anthropic.com/settings/keys",instructions:"Anthropic API key used with the x-api-key header. Create or manage API keys in the Anthropic Console: https://console.anthropic.com/settings/keys."}]},{type:"calendly",service:"calendly",label:"Calendly",description:"Calendly scheduling, event types, and invitees",icon:"/static/connex/calendly.svg",enabled:!0,methods:[{kind:"oauth",service:{name:"Calendly",serviceUrl:"https://calendly.com",docUrl:"https://developer.calendly.com/creating-an-oauth-app",oauthSettingsUrl:"https://developer.calendly.com/console/apps",oauth:{authorization_endpoint:"https://auth.calendly.com/oauth/authorize",token_endpoint:"https://auth.calendly.com/oauth/token",token_endpoint_auth_methods_supported:["client_secret_post"],code_challenge_methods_supported:["S256"]}}},{kind:"api-key",name:"Calendly",service:"api.calendly.com",docUrl:"https://calendly.com/integrations/api_webhooks",instructions:"Calendly personal access token used with the Authorization Bearer header. Create it from API & Webhooks in the Calendly Integrations page: https://calendly.com/integrations/api_webhooks"}]},{type:"canva",service:"canva",label:"Canva",description:"Canva designs, assets, and brand templates",icon:"/static/connex/canva.svg",enabled:!0,methods:[{kind:"oauth",service:{name:"Canva",serviceUrl:"https://www.canva.com",docUrl:"https://www.canva.dev/docs/connect/creating-integrations/",oauth:{authorization_endpoint:"https://www.canva.com/api/oauth/authorize",token_endpoint:"https://api.canva.com/rest/v1/oauth/token",token_endpoint_auth_methods_supported:["client_secret_basic"],code_challenge_methods_supported:["S256"]}}}]},{type:"circleci",service:"circleci",label:"CircleCI",description:"CircleCI pipelines, workflows, and jobs",icon:"/static/connex/circleci.svg",enabled:!0,methods:[{kind:"api-key",name:"CircleCI",service:"circleci.com",docUrl:"https://app.circleci.com/settings/user/tokens",instructions:"CircleCI personal API token used with the Circle-Token header. API v2 does not support project tokens. Create it from User Settings > Personal API Tokens in CircleCI: https://app.circleci.com/settings/user/tokens."}]},{type:"clerk",service:"clerk",label:"Clerk",description:"Clerk users, organizations, and sessions",icon:"/static/connex/clerk.svg",enabled:!0,methods:[{kind:"api-key",name:"Clerk",service:"api.clerk.com",docUrl:"https://dashboard.clerk.com/last-active?path=api-keys",instructions:"Clerk secret key used with the Authorization Bearer header. Create or reveal it in the Clerk Dashboard API keys page: https://dashboard.clerk.com/last-active?path=api-keys"}]},{type:"clickup",service:"clickup",label:"ClickUp",description:"ClickUp tasks, lists, and workspaces",icon:"/static/connex/clickup.svg",enabled:!0,methods:[{kind:"oauth",service:{name:"ClickUp",serviceUrl:"https://clickup.com",docUrl:"https://developer.clickup.com/docs/authentication",oauthSettingsUrl:"https://app.clickup.com/settings/apps",oauth:{authorization_endpoint:"https://app.clickup.com/api",token_endpoint:"https://api.clickup.com/api/v2/oauth/token",token_endpoint_auth_methods_supported:["client_secret_post"]}}},{kind:"api-key",name:"ClickUp",service:"api.clickup.com",docUrl:"https://developer.clickup.com/docs",instructions:"ClickUp personal API token sent with the Authorization header. Generate it from Settings > Apps, or see https://developer.clickup.com/docs."}]},{type:"cohere",service:"cohere",label:"Cohere",description:"Cohere command, embed, and rerank models",icon:"/static/connex/cohere.svg",enabled:!0,methods:[{kind:"api-key",name:"Cohere",service:"api.cohere.com",docUrl