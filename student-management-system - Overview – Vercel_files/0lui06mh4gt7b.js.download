kind:"oauth-template",name:"Salesforce",serviceUrlTemplate:"https://{domain}",docUrl:"https://help.salesforce.com/s/articleView?id=sf.remoteaccess_oauth_web_server_flow.htm&type=5",oauthTemplate:{authorization_endpoint:"https://{domain}/services/oauth2/authorize",token_endpoint:"https://{domain}/services/oauth2/token",revocation_endpoint:"https://{domain}/services/oauth2/revoke",userinfo_endpoint:"https://{domain}/services/oauth2/userinfo",scopes_supported:["api","refresh_token","openid","id"],grant_types_supported:["authorization_code","refresh_token"]},fields:[{key:"domain",label:"Salesforce domain",placeholder:"login.salesforce.com",default:"login.salesforce.com",format:"salesforce-login-host",help:"Your Salesforce login host. Leave blank to use login.salesforce.com. Most orgs use their My Domain (e.g. mycompany.my.salesforce.com); sandboxes use test.salesforce.com."}],additionalInstructions:"In Salesforce **Setup → App Manager**, create a connected app (or External Client App) with OAuth enabled and add the redirect URI as a **Callback URL**. Salesforce calls the credentials **Consumer Key** (Client ID) and **Consumer Secret** (Client Secret)."}]},{type:"notion",service:"notion",label:"Notion",description:"Notion integration",icon:"/static/connex/notion.svg",enabled:!0,methods:[{kind:"oauth",service:{name:"Notion",serviceUrl:"https://www.notion.so",oauthSettingsUrl:"https://www.notion.so/my-integrations",oauth:{authorization_endpoint:"https://api.notion.com/v1/oauth/authorize?owner=user",token_endpoint:"https://api.notion.com/v1/oauth/token",token_endpoint_auth_methods_supported:["client_secret_basic"]}},additionalInstructions:"Create a public integration. Internal integrations can’t use OAuth."},{kind:"oauth-discovery",name:"Notion",label:"MCP",discoveryServerUrl:"https://mcp.notion.com"},{kind:"api-key",name:"Notion",service:"api.notion.com",instructions:"[Create a Notion integration token](https://app.notion.com/developers/tokens) and paste it below. Then share the pages or databases the integration should access."}]},{type:"workos",service:"workos",label:"WorkOS",description:"WorkOS SSO",icon:"/static/connex/workos.svg",enabled:!0,methods:[{kind:"oauth-template",name:"WorkOS",oauthTemplate:{authorization_endpoint:"https://{domain}/sso/authorize",token_endpoint:"https://{domain}/sso/token",token_endpoint_auth_methods_supported:["client_secret_post"],userinfo_endpoint:"https://{domain}/sso/profile"},fields:[{key:"domain",label:"WorkOS domain",placeholder:"api.workos.com",default:"api.workos.com",help:"Your WorkOS API host. Leave blank to use api.workos.com."}],additionalInstructions:"**Placeholder — replace with WorkOS setup steps.** Open the [WorkOS dashboard](https://dashboard.workos.com) and create an application."}]},{type:"okta",service:"okta",label:"Okta",description:"Okta identity and SSO",icon:"/static/connex/okta.svg",enabled:!0,methods:[{kind:"oauth-template",name:"Okta",label:"Org Authorization Server (OAuth 2.0)",subtitle:"Register here if your Issuer URI is a domain with no /oauth2/ segment.",serviceUrl:"https://www.okta.com",docUrl:"https://developer.okta.com/docs/guides/implement-oauth-for-okta/main/",oauthTemplate:{issuer:"https://{domain}",authorization_endpoint:"https://{domain}/oauth2/v1/authorize",token_endpoint:"https://{domain}/oauth2/v1/token",userinfo_endpoint:"https://{domain}/oauth2/v1/userinfo",jwks_uri:"https://{domain}/oauth2/v1/keys",token_endpoint_auth_methods_supported:["client_secret_post","client_secret_basic"],code_challenge_methods_supported:["S256"]},fields:[{key:"domain",label:"Okta domain",placeholder:"acme.okta.com",help:"Your Okta domain, without the https:// prefix. Your Issuer URI is shown in Okta under Security > API > Authorization Servers."}],userAuthorization:{scopes:["openid","profile","email","groups"]},forwardedClaims:{idToken:["email","name","preferred_username","groups"]}},{kind:"oauth-template",name:"Okta",label:"Custom Authorization Server (OAuth 2.0)",subtitle:"Register here if your Issuer URI has a segment like /oauth2/[server id].",serviceUrl:"https://www.okta.com",docUrl:"https://developer.okta.com/docs/guides/implement-oauth-for-okta/main/",oauthTemplate:{issuer:"https://{domain}/oauth2/{auth_server_id}",authorization_endpoint:"https://{domain}/oauth2/{auth_server_id}/v1/authorize",token_endpoint:"https://{domain}/oauth2/{auth_server_id}/v1/token",userinfo_endpoint:"https://{domain}/oauth2/{auth_server_id}/v1/userinfo",jwks_uri:"https://{domain}/oauth2/{auth_server_id}/v1/keys",token_endpoint_auth_methods_supported:["client_secret_post","client_secret_basic"],code_challenge_methods_supported:["S256"]},fields:[{key:"domain",label:"Okta domain",placeholder:"acme.okta.com",help:"Your Okta domain, without the https:// prefix."},{key:"auth_server_id",label:"Authorization Server ID",placeholder:"default",default:"default",help:"This value is either 'default' or a custom server ID. Your Issuer URI with this server ID is shown in Okta under Security > API > Authorization Servers."}],userAuthorization:{scopes:["openid","profile","email"]}}]},{type:"figma",service:"figma",label:"Figma",description:"Figma design platform",icon:"/static/connex/figma.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Figma",discoveryServerUrl:"https://www.figma.com",disableAutoRegistration:!0}]},{type:"vercel",service:"vercel",label:"Vercel",description:"Vercel MCP server",icon:"/static/connex/vercel.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Vercel",label:"MCP",discoveryServerUrl:"https://mcp.vercel.com"}]},{type:"resend",service:"resend",label:"Resend",description:"Email for developers",icon:"/static/connex/resend.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Resend",discoveryServerUrl:"https://api.resend.com",serviceUrl:"https://resend.com",docUrl:"https://resend.com/docs/api-reference/oauth/register"},{kind:"oauth-discovery",name:"Resend",label:"MCP",discoveryServerUrl:"https://mcp.resend.com",serviceUrl:"https://resend.com",docUrl:"https://resend.com/docs/mcp-server"},{kind:"api-key",name:"Resend",service:"api.resend.com",docUrl:"https://resend.com/api-keys",instructions:"Create an API key under [Resend → API Keys](https://resend.com/api-keys) and paste it below."}]},{type:"workday",service:"workday",label:"Workday",description:"Workday HR platform",icon:"/static/connex/workday.svg",enabled:!0,methods:[{kind:"oauth-template",name:"Workday",serviceUrl:"https://www.workday.com",docUrl:"https://community.workday.com/sites/default/files/file-hosting/restapi/index.html",oauthTemplate:{authorization_endpoint:"https://{authorization_host}/{tenant}/authorize",token_endpoint:"https://{token_host}/ccx/oauth2/{tenant}/token"},fields:[{key:"tenant",label:"Workday tenant",placeholder:"mycompany",help:"Enter your Workday tenant name, such as mycompany or mycompany_preview."},{key:"authorization_host",label:"Authorization host",placeholder:"impl.workday.com",help:"From the Authorization Endpoint in your Workday View API Clients report, enter the host between https:// and /{tenant}/authorize, such as impl.workday.com or www.myworkday.com."},{key:"token_host",label:"Token host",placeholder:"wd2-impl-services1.workday.com",help:"From the Token Endpoint in View API Clients, enter the host between https:// and /ccx/oauth2/, such as wd2-impl-services1.workday.com; it may differ from the authorization host."}],additionalInstructions:"In Workday, search for Register API Client for Integrations and create a client with Authorization Code Grant. Add the redirect URI as a Redirection URI. Copy the Authorization Endpoint and Token Endpoint from the View API Clients report to fill in the tenant and hosts above."}]},{type:"microsoft-entra",service:"microsoft",label:"Microsoft",description:"Microsoft integration",icon:"/static/connex/microsoft.svg",enabled:!0},{type:"shopify",service:"shopify",label:"Shopify",description:"Shopify commerce platform",icon:"/static/connex/shopify.svg",enabled:!0,methods:[{kind:"oauth-template",name:"Shopify",serviceUrlTemplate:"https://{store_domain}",docUrl:"https://shopify.dev/docs/apps/build/authentication-authorization/access-tokens/authorization-code-grant",oauthSettingsUrl:"https://dev.shopify.com/dashboard",oauthTemplate:{authorization_endpoint:"https://{store_domain}/admin/oauth/authorize",token_endpoint:"https://{store_domain}/admin/oauth/access_token",token_endpoint_auth_methods_supported:["client_secret_post"],grant_types_supported:["authorization_code"]},fields:[{key:"store_domain",label:"Store domain",placeholder:"your-store.myshopify.com",example:"acme.myshopify.com",help:"Your store’s full myshopify.com domain (e.g. acme.myshopify.com), not just the store name."}],additionalInstructions:"Create the app in the **Shopify Dev Dashboard**. Add the redirect URI under **Allowed redirection URL(s)** in the app configuration."}]},{type:"jira",service:"jira",label:"Jira",description:"Jira issue tracking",icon:"/static/connex/jira.svg",enabled:!0,methods:[{kind:"oauth",service:{name:"Jira",serviceUrl:"https://www.atlassian.com/software/jira",docUrl:"https://developer.atlassian.com/cloud/jira/platform/oauth-2-3lo-apps/",oauthSettingsUrl:"https://developer.atlassian.com/console/myapps/",oauth:{issuer:"https://auth.atlassian.com",authorization_endpoint:"https://auth.atlassian.com/authorize?audience=api.atlassian.com&prompt=consent",token_endpoint:"https://auth.atlassian.com/oauth/token",revocation_endpoint:"https://auth.atlassian.com/oauth/revoke",code_challenge_methods_supported:["S256"],token_endpoint_auth_methods_supported:["client_secret_post","client_secret_basic"]}},additionalInstructions:"In the [Atlassian Developer Console](https://developer.atlassian.com/console/myapps/), create an **OAuth 2.0 integration**, then under **Permissions** add the Jira APIs your use case needs so their scopes become available."},{kind:"oauth-discovery",name:"Jira",label:"MCP",discoveryServerUrl:"https://mcp.atlassian.com"}]},{type:"sanity",service:"sanity",label:"Sanity",description:"Sanity content platform",icon:"/static/connex/sanity.svg",enabled:!0,methods:[{kind:"oauth",service:{name:"Sanity",serviceUrl:"https://www.sanity.io",docUrl:"https://www.sanity.io/docs/oauth2",oauthSettingsUrl:"https://www.sanity.io/contact/sales?ref=oauth",oauth:{issuer:"https://api.sanity.io",authorization_endpoint:"https://api.sanity.io/v2021-06-07/auth/oauth/authorize",token_endpoint:"https://api.sanity.io/v2021-06-07/auth/oauth/token",userinfo_endpoint:"https://api.sanity.io/v2021-06-07/users/me",grant_types_supported:["authorization_code"]}},additionalInstructions:"Sanity provisions OAuth applications on request — use the link above to ask Sanity for a Client ID and secret. Sanity does not issue refresh tokens, so users re-authenticate once the access token expires."},{kind:"oauth-discovery",name:"Sanity",label:"MCP",discoveryServerUrl:"https://mcp.sanity.io"},{kind:"api-key",name:"Sanity",service:"api.sanity.io",docUrl:"https://www.sanity.io/manage",instructions:"Create a robot token in your project’s [management console](https://www.sanity.io/manage) under Settings → API → Tokens, then paste it below."}]},{type:"bamboohr",service:"bamboohr",label:"BambooHR",description:"BambooHR HR platform",icon:"/static/connex/bamboohr.svg",enabled:!0,methods:[{kind:"oauth-template",name:"BambooHR",serviceUrlTemplate:"https://{subdomain}.bamboohr.com",docUrl:"https://documentation.bamboohr.com/docs/getting-started",oauthSettingsUrl:"https://developers.bamboohr.com/",oauthTemplate:{authorization_endpoint:"https://{subdomain}.bamboohr.com/authorize.php?request=authorize",token_endpoint:"https://{subdomain}.bamboohr.com/token.php?request=token",token_endpoint_auth_methods_supported:["client_secret_post"],grant_types_supported:["authorization_code","refresh_token"]},fields:[{key:"subdomain",label:"Company domain",placeholder:"mycompany",example:"mycompany",help:'The part before .bamboohr.com in your BambooHR URL — if you log in at https://mycompany.bamboohr.com, enter "mycompany".'}],additionalInstructions:"In the [BambooHR Developer Portal](https://developers.bamboohr.com/), click **Add Application**, then open **App details** and add the redirect URI under **Redirect URIs**. Copy the Client ID and Client Secret from the **App Credentials** section."},{kind:"api-key",name:"BambooHR",service:"api.bamboohr.com",docUrl:"https://documentation.bamboohr.com/docs/getting-started",instructions:"In BambooHR, click your name in the lower-left corner, choose **API Keys**, then **Add New Key** and paste the generated key below. Requests use HTTP Basic auth with the key as the username and any value as the password, and every API URL includes your company domain, e.g. `https://api.bamboohr.com/api/gateway.php/{company}/v1/…`."}]},{type:"docusign",service:"docusign",label:"Docusign",description:"Docusign electronic signature and agreement platform",icon:"/static/connex/docusign.svg",enabled:!0,methods:[{kind:"oauth-template",name:"Docusign",serviceUrlTemplate:"https://{account_host}",docUrl:"https://developers.docusign.com/platform/auth/authcode/",oauthSettingsUrl:"https://admin.docusign.com/apps-and-keys",oauthTemplate:{issuer:"https://{account_host}/",authorization_endpoint:"https://{account_host}/oauth/auth",token_endpoint:"https://{account_host}/oauth/token",userinfo_endpoint:"https://{account_host}/oauth/userinfo",jwks_uri:"https://{account_host}/openid-configuration/jwks",grant_types_supported:["authorization_code","refresh_token"]},fields:[{key:"account_host",label:"Docusign account host",placeholder:"account.docusign.com",default:"account.docusign.com",help:"Docusign identity host. Use `account.docusign.com` for production, or `account-d.docusign.com` for the developer sandbox."}],additionalInstructions:"In the Docusign [Apps and Keys](https://admin.docusign.com/apps-and-keys) admin console (or the [developer sandbox](https://admindemo.docusign.com/apps-and-keys) for `account-d.docusign.com`), create an app with **Authorization Code Grant** and add the redirect URI under **Redirect URIs**. Docusign calls the credentials **Integration Key** (Client ID) and **Secret Key** (Client Secret)."}]},{type:"dovetail",service:"dovetail",label:"Dovetail",description:"Dovetail customer intelligence platform",icon:"/static/connex/dovetail.svg",enabled:!0,methods:[{kind:"api-key",name:"Dovetail",service:"dovetail.com",docUrl:"https://developers.dovetail.com/docs/authorization",instructions:"Create a personal API token under [Dovetail → Settings → Account → API](https://dovetail.com/settings/user/account) and paste it below. Tokens expire after 30 days, so you will need to rotate it."}]},{type:"kernel",service:"kernel",label:"Kernel",description:"Kernel cloud browsers for AI agents",icon:"/static/connex/kernel.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Kernel",label:"MCP",discoveryServerUrl:"https://mcp.onkernel.com"},{kind:"api-key",name:"Kernel",service:"api.onkernel.com",docUrl:"https://dashboard.onkernel.com",instructions:"Create an API key at [Kernel dashboard → API keys](https://dashboard.onkernel.com) and paste it below."}]},{type:"beehiiv",service:"beehiiv",label:"beehiiv",description:"Newsletter publishing, subscriptions, and automations",icon:"/static/connex/beehiiv.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"beehiiv",discoveryServerUrl:"https://mcp.beehiiv.com/mcp",label:"MCP",serviceUrl:"https://www.beehiiv.com",docUrl:"https://www.beehiiv.com/support/article/39255979546263-getting-started-with-the-beehiiv-mcp"},{kind:"oauth",service:{name:"beehiiv",serviceUrl:"https://www.beehiiv.com",docUrl:"https://developers.beehiiv.com/oauth2",oauth:{authorization_endpoint:"https://app.beehiiv.com/oauth/authorize",token_endpoint:"https://app.beehiiv.com/oauth/token",revocation_endpoint:"https://app.beehiiv.com/oauth/revoke",introspection_endpoint:"https://app.beehiiv.com/oauth/introspect"}},additionalInstructions:"beehiiv OAuth clients are not self-serve — contact [beehiiv Support](https://support.beehiiv.com/hc/en-us) to register a client and receive your Client ID and Secret."},{kind:"api-key",name:"beehiiv",service:"api.beehiiv.com",docUrl:"https://developers.beehiiv.com/welcome/create-an-api-key",instructions:"In beehiiv, open **Settings → Workspace Settings → API**, click **Create New API Key**, and paste the key below."}]},{type:"webflow",service:"webflow",label:"Webflow",description:"Manage Webflow CMS, pages, assets and sites",icon:"/static/connex/webflow.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Webflow",discoveryServerUrl:"https://mcp.webflow.com/mcp",label:"MCP",serviceUrl:"https://webflow.com",docUrl:"https://developers.webflow.com/mcp/reference/overview"},{kind:"oauth",service:{name:"Webflow",serviceUrl:"https://webflow.com",docUrl:"https://developers.webflow.com/data/reference/oauth-app",oauthSettingsUrl:"https://webflow.com/dashboard",oauth:{authorization_endpoint:"https://webflow.com/oauth/authorize",token_endpoint:"https://api.webflow.com/oauth/access_token",revocation_endpoint:"https://webflow.com/oauth/revoke_authorization"}},additionalInstructions:"In your Webflow Workspace dashboard, open **Apps & integrations → App Development** and create an app with the **Data Client** building block. Set the redirect URI in the app’s Building Blocks settings — only workspace admins can view the client secret."},{kind:"api-key",name:"Webflow",service:"api.webflow.com",docUrl:"https://developers.webflow.com/data/reference/authentication/site-token",instructions:"Generate a site token under **Site settings → Apps & integrations → API access** and paste it below. For workspace-level access (Enterprise only), generate a workspace token under **Workspace settings → Apps & integrations → Manage → Workspace API access** instead."}]},{type:"datadog",service:"datadog",label:"Datadog",description:"Cloud monitoring and observability",icon:"/static/connex/datadog.svg",enabled:!0,methods:[{kind:"api-key",name:"Datadog",service:"api.datadoghq.com",docUrl:"https://docs.datadoghq.com/account_management/api-app-keys/",instructions:"Create an [API key](https://app.datadoghq.com/organization-settings/api-keys) and paste it below. If needed, add an [application key](https://app.datadoghq.com/personal-settings/application-keys) with **Add Another**, and change **Service** from `api.datadoghq.com` to your Datadog site’s API host."}]},{type:"n8n",service:"n8n",label:"n8n",description:"n8n workflow automation",icon:"/static/connex/n8n.svg",enabled:!0,methods:[{kind:"api-key",name:"n8n",service:"n8n.cloud",docUrl:"https://docs.n8n.io/api/authentication/",instructions:"In your n8n instance, open **Settings → n8n API**, click **Create an API key**, and paste the key below. Requests use the `X-N8N-API-KEY` header and must target your instance base URL — e.g. `https://{subdomain}.app.n8n.cloud/api/v1` for n8n Cloud, or `https://{your-host}/api/v1` for self-hosted."}]},{type:"photon",service:"photon",label:"Photon",description:"Multi-platform messaging for AI agents",icon:"/static/connex/photon.svg",enabled:!0,methods:[{kind:"api-key",name:"Photon",service:"spectrum.photon.codes",docUrl:"https://photon.codes/docs/api-reference/introduction",instructions:"The Spectrum API uses HTTP Basic auth with your project ID as the username and project secret as the password. Grab both from `photon projects show` or your project page in the [Photon dashboard](https://app.photon.codes), combine them as `<projectId>:<projectSecret>`, and paste the combined value below. Requests target `https://spectrum.photon.codes`."}]},{type:"fathom",service:"fathom",label:"Fathom",description:"AI meeting notes and transcripts",icon:"/static/connex/fathom.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Fathom",label:"MCP",discoveryServerUrl:"https://api.fathom.ai",serviceUrl:"https://fathom.video",docUrl:"https://developers.fathom.ai/api-overview"},{kind:"api-key",name:"Fathom",service:"api.fathom.ai",docUrl:"https://developers.fathom.ai/quickstart",instructions:"In Fathom, open [Settings](https://fathom.video/settings), scroll to **API Access**, click **Add → Generate API Key**, and paste the key below. Fathom expects the key in the `X-Api-Key` header on requests to `https://api.fathom.ai/external/v1`."}]},{type:"npm",service:"npm",label:"npm",description:"JavaScript package registry",icon:"/static/connex/npm.svg",enabled:!0,methods:[{kind:"api-key",name:"npm",service:"registry.npmjs.org",docUrl:"https://docs.npmjs.com/creating-and-viewing-access-tokens",instructions:"Create a granular access token at [npmjs.com → Access Tokens](https://www.npmjs.com/settings/~/tokens) and paste it below."}]},{type:"airtable",service:"airtable",label:"Airtable",description:"Airtable bases, tables, and records",icon:"/static/connex/airtable.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Airtable",discoveryServerUrl:"https://mcp.airtable.com/mcp",label:"MCP"}]},{type:"asana",service:"asana",label:"Asana",description:"Connect to Asana to coordinate tasks, projects, and goals",icon:"/static/connex/asana.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Asana",discoveryServerUrl:"https://mcp.asana.com/v2/mcp",label:"MCP",disableAutoRegistration:!0,oauthSettingsUrl:"https://app.asana.com/0/my-apps",docUrl:"https://developers.asana.com/docs/integrating-with-asanas-mcp-server",additionalInstructions:'Create the app in the Asana developer console and pick the "MCP app" type.'}]},{type:"bitly",service:"bitly",label:"Bitly",description:"Shorten links, generate QR Codes, and track performance",icon:"/static/connex/bitly.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Bitly",discoveryServerUrl:"https://api-ssl.bitly.com/v4/mcp",label:"MCP"}]},{type:"box",service:"box",label:"Box",description:"Search, edit and get insights on your Box content",icon:"/static/connex/box.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Box",discoveryServerUrl:"https://mcp.box.com",label:"MCP",disableAutoRegistration:!0,oauthSettingsUrl:"https://app.box.com/developers/console",docUrl:"https://developer.box.com/guides/box-mcp/remote/",additionalInstructions:"Box documents MCP credentials under Admin Console > Integrations > Add Integration Credentials (admin access required)."}]},{type:"brex",service:"brex",label:"Brex",description:"Intelligent finance automation",icon:"/static/connex/brex.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Brex",discoveryServerUrl:"https://api.brex.com/mcp",label:"MCP"}]},{type:"candid",service:"candid",label:"Candid",description:"Research nonprofits and funders using Candid's data",icon:"/static/connex/candid.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Candid",discoveryServerUrl:"https://mcp.candid.org/mcp",label:"MCP"}]},{type:"clickhouse",service:"clickhouse",label:"ClickHouse",description:"Query and explore your ClickHouse Cloud data",icon:"/static/connex/clickhouse.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"ClickHouse",discoveryServerUrl:"https://mcp.clickhouse.cloud/mcp",label:"MCP"}]},{type:"cloudflare",service:"cloudflare",label:"Cloudflare",description:"Build applications with compute, storage, and AI",icon:"/static/connex/cloudflare.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Cloudflare",discoveryServerUrl:"https://mcp.cloudflare.com/mcp",label:"MCP"}]},{type:"cloudinary",service:"cloudinary",label:"Cloudinary",description:"Manage, transform and deliver your images & videos",icon:"/static/connex/cloudinary.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Cloudinary",discoveryServerUrl:"https://asset-management.mcp.cloudinary.com/sse",label:"MCP"}]},{type:"coda",service:"coda",label:"Coda",description:"Create, search, update docs and tables",icon:"/static/connex/coda.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Coda",discoveryServerUrl:"https://coda.io/apis/mcp",label:"MCP"}]},{type:"egnyte",service:"egnyte",label:"Egnyte",description:"Securely access and analyze Egnyte co